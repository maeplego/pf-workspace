# 開発モード（OIDC なし）では WORKSPACE_DEV_AUTH=true のまま起動可
WORKSPACE_DEV_AUTH=true
WORKSPACE_CORS_ORIGIN=http://localhost:3006
WORKSPACE_API_URL=http://workspace-api:8096
WORKSPACE_INTERNAL_TOKEN=dev-collab-internal
COLLAB_API_URL=http://workspace-api:8096
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:8097
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8096/chat/ws

# OIDC 連携時（pf-identity と組み合わせ）
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_CLIENT_ID=pf-workspace-web
# OIDC_REDIRECT_URI=http://localhost:3006/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3006/logged-out
