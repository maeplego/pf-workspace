# development (default) | staging | production
# staging/production では WORKSPACE_DEV_AUTH を禁止し OIDC_ISSUER 必須
WORKSPACE_ENV=development
# OIDC 時は org_id 必須（staging/production では常に true。development+OIDC でも既定 true）
# WORKSPACE_REQUIRE_ORG=true

# 開発モード（OIDC なし）では WORKSPACE_DEV_AUTH=true のまま起動可
WORKSPACE_DEV_AUTH=true
# Compose 専用 DB。空にすると API はメモリ store（単体テスト向け）
WORKSPACE_DATABASE_URL=postgres://workspace:workspace@workspace-db:5432/workspace?sslmode=disable
WORKSPACE_CORS_ORIGIN=http://localhost:3006
WORKSPACE_API_URL=http://workspace-api:8096
WORKSPACE_INTERNAL_TOKEN=dev-collab-internal
COLLAB_API_URL=http://workspace-api:8096
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:8097
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8096/chat/ws
WORKSPACE_PUBLIC_URL=http://localhost:8096

# 任意: P03 を別起動したときだけ（単体 Compose には media を含めない）
# MEDIA_API_URL=http://host.docker.internal:8090

# OIDC 連携時（pf-identity と組み合わせ）。K8s overlay の web は OIDC 必須。Compose は上記 DEV_AUTH のまま。
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_CLIENT_ID=pf-workspace-web
# OIDC_REDIRECT_URI=http://localhost:3006/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3006/logged-out
